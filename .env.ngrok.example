# ngrok tunnel config for local dev (docker-compose.dev.yml).
# Copy to .env.ngrok and fill in — this file is separate from .env because
# it configures the tunnel, not the app itself (src/config/env.ts doesn't
# know about it).
#
# NGROK_AUTHTOKEN: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_DOMAIN: claim a free static domain (stays the same across restarts)
#   at https://dashboard.ngrok.com/domains, e.g. your-name.ngrok-free.app
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
